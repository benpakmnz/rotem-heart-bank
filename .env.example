# The game's Firebase database is built in (src/party/net/firebaseConfig.js).
# Set this only to use a different Realtime Database (see README):
# REACT_APP_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app

# Local Firebase emulator instead (development only):
# REACT_APP_FIREBASE_EMULATOR_HOST=127.0.0.1:9000
